# Google AI Studio API key. Used for Gemini vision AND Gemini Google Search-grounded pricing.
# Create it at https://aistudio.google.com/apikey and keep your real .env private.
GOOGLE_API_KEY=replace_with_your_gemini_api_key
LIBRARY_VISION_MODEL=gemini-2.5-flash
LIBRARY_PRICE_MODEL=gemini-2.5-flash

# Optional: set these to the current rates for the model you use to estimate cost per sweep.
# Leave blank rather than using stale prices. Values are USD per 1,000,000 tokens.
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=
